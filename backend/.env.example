APP_NAME=AI Google Ads Optimizer
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
DATABASE_URL=postgresql+asyncpg://optimizer:optimizer@postgres:5432/ads_optimizer
JWT_SECRET=change-me
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
FRONTEND_URL=http://localhost:5173
# Railway sets RAILWAY_PUBLIC_DOMAIN and RAILWAY_VOLUME_MOUNT_PATH automatically.
# Optional override for durable OAuth storage outside Railway:
GOOGLE_OAUTH_STORE_PATH=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_IDS=
ENABLE_LIVE_GOOGLE_ADS_MUTATIONS=false
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
AFFILIATE_RESEARCH_MAX_RESULTS=5
ENABLE_HEADLESS_BROWSER=true
PAGE_READER_HTTP_TIMEOUT_SECONDS=8
PAGE_READER_BROWSER_TIMEOUT_MS=12000
PAGE_READER_SETTLE_MS=750
PAGE_READER_MIN_WORDS=80
PAGE_READER_MIN_CONFIDENCE=55

OPENAI_API_KEY=
GEMINI_API_KEY=
AI_PROVIDER=openai
